{
    "build": {
        "dockerfile": "Dockerfile",
        "options": [
            "--platform=linux/amd64"
        ]
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools-extension-pack",
                "ms-python.python",
                "ms-azuretools.vscode-containers"
            ]
        },
        "codespaces": {
            "repositories": {
                "PikalaxALT/pokeheartgold": {
                    "permissions": {
                        "workflows": "write"
                    }
                }
            }
        }
    },
    "postCreateCommand": "bash ./.devcontainer/setup-devcontainer.sh"
}
