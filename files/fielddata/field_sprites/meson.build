follower_mon_texture_names_file = files('follower_pokemon/follower_mon_texture_names.txt')

foreach texture : follower_mon_files
    file = files('follower_pokemon/' + texture['mon'] + '/' + texture['mon'] + texture['form'] + '.png') 
    field_sprites_nsbtxs += custom_target(
        input: file,
        build_subdir: field_sprites_private_dir,
        output: '@BASENAME@.nsbtx',
        command: [
            nitrobtx_exe,
            'pack',
            '--texture', '@INPUT@',
            '--format', '4bpp',
            '--spritesheet',
            '--names-file', follower_mon_texture_names_file,
            '--keep-duplicates',
            '--frame-height', '32',
            '--extract-palette',
            '--name', 'tsure_poke0',
            '--palette', files('follower_pokemon/' + texture['mon'] + '/' + texture['mon'] + texture['form'] + '_shiny.png'),
            '--name', 'tsure_poke1',
            '@OUTPUT@'
        ],
    )
endforeach

