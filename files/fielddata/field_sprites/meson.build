foreach texture : follower_mon_big_files
    file = files('follower_pokemon/' + texture['mon'] + '/' + texture['mon'] + texture['form'] + '.png') 
    field_sprites_nsbtxs += custom_target(
        input: file,
        build_subdir: field_sprites_private_dir,
        output: '@BASENAME@.nsbtx',
        command: [
            nitrobtx_exe,
            'pack',
            '--texture', '@INPUT@',
            '--name', 'tsure_poke',
            '--format', '4bpp',
            '--spritesheet',
            '--frame-height', '64',
            '--extract-palette',
            '--name', 'tsure_poke0',
            '--palette', files('follower_pokemon/' + texture['mon'] + '/' + texture['mon'] + texture['form'] + '_shiny.png'),
            '--name', 'tsure_poke1',
            '@OUTPUT@'
        ],
    )
endforeach

field_sprites_template = files('field_sprites.json.txt')

field_sprites_bin_gen = generator(json2bin_sh,
    arguments : [
        '--compiler', ' '.join(meson.get_compiler('nasm', native: false).cmd_array()),
        '--jsonproc', jsonproc_exe.full_path(),
        '--template', field_sprites_template[0].full_path(),
        '--obj-copy',
        '--out-dir', build_dir + '/' + field_sprites_private_dir,
        '--language', 'asm',
        '@INPUT@'
    ],
    depends : [
        jsonproc_exe,
        o2narc_exe,
    ],
    output : '@BASENAME@.bin'
)

field_sprites_narc = custom_target('field_sprites.narc',
    output: [
        'field_sprites.narc',
        'field_sprites.naix'
    ],
    input: [
        field_sprites_bin_gen.process(field_sprites_bin_json),
        field_sprites_nsbtxs,
        field_sprites_nsbmd,
    ],
    command: [
        nitroarc_exe,
        '--create',
        '--index',
        '--files-from', files('field_sprites.order'),
        '--file', '@OUTPUT0@',
        '@PRIVATE_DIR@',
    ],
)

nitrofs_files += field_sprites_narc
naix_headers += field_sprites_narc[1]
