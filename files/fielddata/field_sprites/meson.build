    { 'file' : 'apricorn/apricorn_tree_pink.png', 'basename' : 'bonguri_p' },
    { 'file' : 'apricorn/apricorn_tree_yellow.png', 'basename' : 'bonguri_y' },
]

foreach texture : field_sprites_textures_32_px_repeat_palette_suffix
    if texture.has_key('palette')
        palette = texture['palette']
    else
        palette = texture['basename']
    endif
    field_sprites_nsbtxs += custom_target(
        input: files(texture['file']),
        build_subdir: field_sprites_private_dir,
        output: '@BASENAME@.nsbtx',
        command: [
            nitrobtx_exe,
            'pack',
            '--texture', '@INPUT@',
            '--name', texture['basename'],
            '--format', '4bpp',
            '--spritesheet',
            '--frame-height', '32',
            '--extract-palette',
            '--repeat-palette',
            '--palette-suffix',
            '--name', palette,
            '@OUTPUT@'
        ],
    )
endforeach

