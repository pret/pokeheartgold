{
  "key": 9246,
  "messages": [
    {
      "id": "msg_0449_T01R0201_00000",
      "en_US": [
        "Daisy: Hi! My kid brother is the Gym\n",
        "Leader in Viridian City.\r",
        "But he goes out of town so often,\n",
        "it causes problems for the Trainers."
      ]
    },
    {
      "id": "msg_0449_T01R0201_00001",
      "en_US": [
        "Daisy: Hi! Good timing. I’m about\n",
        "to have some tea.\r",
        "Would you like to join me?\r",
        "Oh, you seem to keep your Pokémon\n",
        "a bit on the dirty side.\r",
        "Grooming helps them become more\n",
        "beautiful and friendly.\r",
        "Would you like me to groom one? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0449_T01R0201_00002",
      "en_US": "Daisy: Which one should I groom?\r"
    },
    {
      "id": "msg_0449_T01R0201_00003",
      "en_US": "{STRVAR_1 0, 0, 0} looks content."
    },
    {
      "id": "msg_0449_T01R0201_00004",
      "en_US": [
        "Daisy: There you go!\n",
        "All done.\r",
        "See? Doesn’t it look nice?\n",
        "It’s such a cute Pokémon."
      ]
    },
    {
      "id": "msg_0449_T01R0201_00005",
      "en_US": [
        "Daisy: I always have tea around\n",
        "this time. Come join me."
      ]
    },
    {
      "id": "msg_0449_T01R0201_00006",
      "en_US": [
        "Daisy: You don’t want to have one\n",
        "groomed? OK, we’ll just have tea."
      ]
    },
    {
      "id": "msg_0449_T01R0201_00007",
      "en_US": [
        "Daisy: Oh, sorry. I honestly can’t\n",
        "groom an Egg."
      ]
    },
    {
      "id": "msg_0449_T01R0201_00008",
      "en_US": [
        "Daisy: You are really into grooming!\n",
        "Say!\f",
        "Would you like my kid brother’s number?\r",
        "He is the Gym Leader at Viridian City.\n",
        "Have you challenged him?\r",
        "Do you want to register him? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0449_T01R0201_00009",
      "en_US": [
        "{STRVAR_1 3, 0, 0} registered Blue\n",
        "in the Pokégear!"
      ]
    },
    {
      "id": "msg_0449_T01R0201_00010",
      "en_US": [
        "Daisy: Give him a call when you feel\n",
        "like it.\r",
        "He can be overly confident, but he\n",
        "still needs company.\r",
        "He said he won’t have any plans on\n",
        "Sunday nights...\f",
        "Giggle!"
      ]
    },
    {
      "id": "msg_0449_T01R0201_00011",
      "en_US": [
        "Daisy: Really? You won’t?\n",
        "I see...\f",
        "How disappointing."
      ]
    },
    {
      "id": "msg_0449_T01R0201_00012",
      "en_US": [
        "Daisy: Do you want to register\n",
        "my kid brother’s number? {YESNO 0}"
      ]
    }
  ]
}
