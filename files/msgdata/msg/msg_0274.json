  "messages": [
    {
      "id": "msg_0274_00000",
      "en_US": [
        "Welcome!\r",
        "From here, you can select a Pokémon\n",
        "from your PC Box and send it to the\f",
        "Pokéwalker to take along on a Stroll.\r"
      ]
    },
    {
      "id": "msg_0274_00001",
      "en_US": [
        "Please select the Pokémon\n",
        "you’d like to take along."
      ]
    },
    {
      "id": "msg_0274_00002",
      "en_US": [
        "Receive Pokémon\n",
        "and gifts."
      ]
    },
    {
      "id": "msg_0274_00003",
      "en_US": [
        "Caution!\r",
        "All data saved on the Pokéwalker will\n",
        "be erased.\r",
        "Before erasing it, please be sure to\n",
        "confirm the information.\r",
        "The Pokémon on your Pokéwalker will\n",
        "return, but all other data on the\f",
        "Pokéwalker will be erased.\r",
        "Erase the data on the Pokéwalker?"
      ]
    },
    {
      "id": "msg_0274_00004",
      "en_US": [
        "All records on the\n",
        "Pokéwalker will be erased."
      ]
    },
    {
      "id": "msg_0274_00005",
      "en_US": [
        "Point at the DS Card\n",
        "and select “CONNECT.”"
      ]
    },
    {
      "id": "msg_0274_00006",
      "en_US": "Connecting to Pokéwalker. Please wait."
    },
    {
      "id": "msg_0274_00007",
      "en_US": [
        "In a place where it’s OK for\n",
        "the Pokéwalker to emit\f",
        "noise, point it at the\f",
        "DS Card, press the button,\f",
        "and wait five seconds."
      ]
    },
    {
      "id": "msg_0274_00008",
      "en_US": [
        "Your Pokémon can now take\n",
        "a Stroll in the Pokéwalker."
      ]
    },
    {
      "id": "msg_0274_00009",
      "en_US": "Carry over the Pokéwalker Step Count?"
    },
    {
      "id": "msg_0274_00010",
      "garbage": 21
    },
    {
      "id": "msg_0274_00011",
      "en_US": [
        "Please select a Pokémon from your\n",
        "PC Box.\r"
      ]
    },
    {
      "id": "msg_0274_00012",
      "en_US": [
        "Select the Route you would\n",
        "like to take a Stroll on.\r"
      ]
    },
    {
      "id": "msg_0274_00013",
      "en_US": [
        "Saving...\n",
        "Do not turn off the power."
      ]
    },
    {
      "id": "msg_0274_00014",
      "garbage": 30
    },
    {
      "id": "msg_0274_00015",
      "en_US": [
        "To use the Pokéwalker, you must have\n",
        "at least five open spaces in a PC Box.\r",
        "Please come back once you have opened\n",
        "at least five spaces.\r"
      ]
    },
    {
      "id": "msg_0274_00016",
      "en_US": [
