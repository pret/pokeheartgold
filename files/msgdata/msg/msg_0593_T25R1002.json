  "key": 60483,
  "messages": [
    {
      "id": "msg_0593_T25R1002_00000",
      "en_US": [
        "The ladies at this department store\n",
        "even greet kids like me with respect.\r",
        "That’s what I call professional!"
      ]
    },
    {
      "id": "msg_0593_T25R1002_00001",
      "en_US": [
        "The ladies at this department store\n",
        "never change their attitude.\r",
        "Be it in front of a regular customer\n",
        "or a Team Rocket member.\r",
        "That’s what I call professional!"
      ]
    },
    {
      "id": "msg_0593_T25R1002_00002",
      "en_US": [
        "The existence of this department store\n",
        "tells me that Goldenrod is a big city.\r",
        "The selection here is unmatched\n",
        "anywhere else."
      ]
    },
    {
      "id": "msg_0593_T25R1002_00003",
      "en_US": [
        "You better listen to me.\r",
        "Quit being a Team Rocket member\n",
        "already!"
      ]
    },
    {
      "id": "msg_0593_T25R1002_00004",
      "en_US": [
        "I got my ABRA at the Game Corner.\f",
        "Now it’s my best partner."
      ]
    },
    {
      "id": "msg_0593_T25R1002_00005",
      "en_US": [
        "Oh, Team Rocket!\n",
        "Please don’t take my ABRA away!"
      ]
    },
    {
      "id": "msg_0593_T25R1002_00006",
      "en_US": [
        "Your Travel Companion\n",
        "2F Trainer’s Market"
      ]
    }
  ]
}
