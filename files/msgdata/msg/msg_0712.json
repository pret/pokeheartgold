{
  "key": 63652,
  "messages": [
    {
      "id": "msg_0712_00000",
      "en_US": "Ralph"
    },
    {
      "id": "msg_0712_00001",
      "en_US": [
        "Don’t young people fish anymore?\r",
        "I can teach you how to fish well, if\n",
        "you’d like to exchange phone\f",
        "numbers with me? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0712_00002",
      "en_US": [
        "That’s great!\n",
        "I’m happy to have made a\f",
        "younger friend!"
      ]
    },
    {
      "id": "msg_0712_00003",
      "en_US": [
        "Oh...\r",
        "My own kids won’t even give me their\n",
        "phone numbers...\r",
        "I guess that’s just how young people\n",
        "are these days."
      ]
    },
    {
      "id": "msg_0712_00004",
      "en_US": [
        "Hm? Oh, so you would like to be my\n",
        "friend after all?! {YESNO 0}"
      ]
    },
    {
      "id": "msg_0712_00005",
      "en_US": [
        "If you’re nearby, let’s just talk\n",
        "face-to-face!"
      ]
    },
    {
      "id": "msg_0712_00006",
      "en_US": [
        "I’ve been spending more time with my\n",
        "{STRVAR_1 0, 10, 0} than I have with my kids.\f",
        "That’s a bit sad, actually.\r",
        "You call your mom sometimes, too!"
      ]
    },
    {
      "id": "msg_0712_00007",
      "en_US": [
        "I just beat a wild {STRVAR_1 0, 11, 0}.\n",
        "I told my kid, but he scoffed that he\f",
        "could do the same thing easily.\r",
        "Boy, has he gotten cocky...\r",
        "You call your mom sometimes, too!"
      ]
    },
    {
      "id": "msg_0712_00008",
      "en_US": [
        "Yesterday a wild {STRVAR_1 0, 11, 0} slipped\n",
        "away from me in front of my kid.\f",
        "I was feeling down about it until he\f",
        "shared his Poké Balls with me.\r",
        "Hahah, that sure made my day!\r",
        "You call your mom sometimes, too!"
      ]
    },
    {
      "id": "msg_0712_00009",
      "en_US": [
        "What do you say to a battle with me?\n",
        "Good, you’re going to do it!\r",
        "For a kid, you’re quite agreeable.\n",
        "{STRVAR_1 4, 3, 0} is the spot!"
      ]
    },
    {
      "id": "msg_0712_00010",
      "en_US": [
        "So where are you? I’m waiting for you\n",
        "to show up on {STRVAR_1 4, 3, 0}.\r",
        "You shouldn’t make your elders wait!"
      ]
    },
    {
      "id": "msg_0712_00011",
      "en_US": [
        "Hey, how are you doing?\r",
        "I’m doing absolutely wonderful,\n",
        "of course!\r",
        "But when I say “...absolutely\n",
        "wonderful,” am I talking about fishing?\f",
        "Am I talking about Pokémon?\f",
        "Which is it?\r",
        "Ha ha ha!\n",
        "It’s both, of course!"
      ]
    }
  ]
}
