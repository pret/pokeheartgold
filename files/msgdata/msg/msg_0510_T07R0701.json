  "messages": [
    {
      "id": "msg_0510_T07R0701_00000",
      "en_US": [
        "Hi!\r",
        "We’re holding an eatathon contest.\n",
        "We can’t serve you right now. Sorry."
      ]
    },
    {
      "id": "msg_0510_T07R0701_00001",
      "en_US": [
        "Huff... Huff... Munch... Munch...\n",
        "Huff... Huff... Munch... Munch...\r",
        "When it comes to eating contests,\n",
        "I’m quite confident.\r",
        "But I can’t handle hot food.\f",
        "If I have to hurry eating, my mouth...\f",
        "Hot, hot, hot!\r"
      ]
    },
    {
      "id": "msg_0510_T07R0701_00002",
      "en_US": [
        "Chomp, chew, munch...\n",
        "(Please don’t talk to me now!)\r",
        "Chomp, chew, cough...\n",
        "(Food is gonna come out of my mouth...)\r"
      ]
    },
    {
      "id": "msg_0510_T07R0701_00003",
      "en_US": [
        "Munch munch munch...\n",
        "...What? This is the eatathon contest?\r",
        "Ouch!\r",
        "I thought it was the speed-eating\n",
        "contest...\r"
      ]
    },
    {
      "id": "msg_0510_T07R0701_00004",
      "en_US": [
        "Crunch... Crunch...\r",
        "I can keep eating!\n",
        "More, chef!\r"
      ]
    },
    {
      "id": "msg_0510_T07R0701_00005",
      "en_US": [
        "Crunch... Crunch...\r",
        "I can keep eating!\n",
        "More, chef!\r"
      ]
    },
    {
      "id": "msg_0510_T07R0701_00006",
      "en_US": [
        "Maylene: Munch munch munch...\n",
        "The eatathon contest!\r",
        "I never dreamed of such a\n",
        "wonderful thing.\r",
        "After a strict diet during training,\n",
        "I can eat like a HIPPOWDON.\r",
        "The winner eats for free, too.\n",
        "That’s just a dream come true!\r"
      ]
    },
    {
      "id": "msg_0510_T07R0701_00007",
      "en_US": [
        "Eatathon Contest!\n",
        "No time limit!\f",
        "A battle without end!\r",
        "The biggest eater gets it\n",
        "all for free!"
      ]
    }
  ]
}
