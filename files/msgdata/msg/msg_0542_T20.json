    {
      "id": "msg_0542_T20_00017",
      "en_US": "Professor Elm: Wait one second!\r"
    },
    {
      "id": "msg_0542_T20_00018",
      "en_US": [
        "I almost completely forgot\n",
        "about this...\f",
        "Here, I’ll give you my number.\r"
