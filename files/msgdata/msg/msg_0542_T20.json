  "messages": [
    {
      "id": "msg_0542_T20_00000",
      "en_US": "Wow, your Pokégear is impressive!"
    },
    {
      "id": "msg_0542_T20_00001",
      "en_US": "Wait, {STRVAR_1 3, 0, 0}!"
    },
    {
      "id": "msg_0542_T20_00002",
      "en_US": "Wait, {STRVAR_1 3, 0, 0}!"
    },
    {
      "id": "msg_0542_T20_00003",
      "en_US": "What do you think you’re doing?\r"
    },
    {
      "id": "msg_0542_T20_00004",
      "en_US": [
        "It’s dangerous to go out without\n",
        "a Pokémon!\r",
        "Wild Pokémon jump out of the grass\n",
        "on the way to the next town."
      ]
    },
    {
      "id": "msg_0542_T20_00005",
      "en_US": [
        "Oh! Your Pokémon is adorable!\n",
        "I wish I had one!"
      ]
    },
    {
      "id": "msg_0542_T20_00006",
      "en_US": [
        "Hi, {STRVAR_1 3, 0, 0}!\n",
        "Leaving again?\r",
        "You should tell your mom if you\n",
        "are leaving."
      ]
    },
    {
      "id": "msg_0542_T20_00007",
      "en_US": [
        "Hi, {STRVAR_1 3, 0, 0}!\n",
        "Leaving again?\r",
        "You should tell your mom if you\n",
        "are leaving."
      ]
    },
    {
      "id": "msg_0542_T20_00008",
      "en_US": [
        "Call your mom on your Pokégear to\n",
        "let her know how you’re doing."
      ]
    },
    {
      "id": "msg_0542_T20_00009",
      "en_US": "I like your Bag!"
    },
    {
      "id": "msg_0542_T20_00010",
      "en_US": "Wait a sec!\r"
    },
    {
      "id": "msg_0542_T20_00011",
      "en_US": [
        "Did you leave your Pokégear at home?\r",
        "You should ask your mom."
      ]
    },
    {
      "id": "msg_0542_T20_00012",
      "en_US": [
        "Yo, {STRVAR_1 3, 0, 0}!\r",
        "I hear Professor Elm discovered some\n",
        "new Pokémon."
      ]
    },
    {
      "id": "msg_0542_T20_00013",
      "en_US": [
        "...\r",
        "So this is the famous Elm Pokémon Lab...\r"
      ]
    },
    {
      "id": "msg_0542_T20_00014",
      "en_US": "...What are you staring at?\r"
    },
    {
      "id": "msg_0542_T20_00015",
      "en_US": [
        "Lyra: {STRVAR_1 3, 0, 0}!\r",
        "So you picked...\n",
        "{STRVAR_1 0, 1, 0}!\r",
        "That’s a cute Pokémon you have!\r",
        "When you walk with it, it’ll become\n",
        "more friendly.\r",
        "You should turn around and talk to it\n",
        "sometimes, too.\r",
        "Oh, that’s right!\n",
        "Why don’t you show it to your mom?\f",
        "See ya!\r"
      ]
    },
    {
      "id": "msg_0542_T20_00016",
      "en_US": [
        "Ethan: {STRVAR_1 3, 0, 0}!\r",
