    {
      "id": "msg_0096_D31R0201_00020",
      "en_US": [
        "Welcome to the Battle Tower!\r",
        "I am your guide to the Multi\n",
        "Battle Rooms.\r"
      ]
    },
    {
      "id": "msg_0096_D31R0201_00021",
      "en_US": [
        "Would you like to take the Multi\n",
        "Battle Room challenge? {YESNO 0}"
