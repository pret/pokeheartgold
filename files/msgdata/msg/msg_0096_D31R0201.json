    },
    {
      "id": "msg_0096_D31R0201_00075",
      "en_US": [
        "Thank you for playing!\r",
        "Your Pokémon will be restored to\n",
        "full...\f",
        "Oh my!\r",
        "I’m not on duty today.\n",
        "I’m just here to enjoy myself."
