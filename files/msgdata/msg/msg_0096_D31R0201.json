  "messages": [
    {
      "id": "msg_0096_D31R0201_00000",
      "en_US": [
        "Welcome to the Battle Tower!\r",
        "I am your guide to the Single\n",
        "and Double Battle Rooms.\r"
      ]
    },
    {
      "id": "msg_0096_D31R0201_00001",
      "en_US": [
        "Would you like to take the\n",
        "Battle Room challenge? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0096_D31R0201_00002",
      "en_US": "We hope to see you again!"
    },
    {
      "id": "msg_0096_D31R0201_00003",
      "en_US": [
        "The Battle Tower is a facility for Single\n",
        "or Double Battle challenges.\r",
        "Once entered, your challenge lasts\n",
        "until you lose.\r",
        "In Single Battle format, you enter with\n",
        "three Pokémon.\r",
        "In Double Battle format, you enter with\n",
        "four Pokémon.\r",
        "The battles are held in Battle Rooms,\n",
        "of which there are many in the tower.\r",
        "In each of the Battle Rooms, seven\n",
        "Trainers await your challenge.\r",
        "If you manage to defeat all seven,\n",
        "you will earn Battle Points (BP).\r",
        "If you want to interrupt your\n",
        "challenge, please save the game.\r",
        "If you don’t save, you will be\n",
        "disqualified from your challenge.\r",
        "Please be aware of that!\r"
      ]
    },
    {
      "id": "msg_0096_D31R0201_00004",
      "en_US": [
        "Which Battle Room would you like?\n",
        "Single or Double? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0096_D31R0201_00005",
      "garbage": 192
    },
    {
      "id": "msg_0096_D31R0201_00006",
      "garbage": 258
    },
    {
