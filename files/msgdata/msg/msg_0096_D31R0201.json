    {
      "id": "msg_0096_D31R0201_00014",
      "en_US": [
        "Saving...\n",
        "Don’t turn off the power."
      ]
    },
    {
      "id": "msg_0096_D31R0201_00015",
      "en_US": "We hope to see you again."
    },
    {
      "id": "msg_0096_D31R0201_00016",
      "en_US": [
        "We’ve been waiting for you!\r",
        "Before entering a Battle Room, your\n",
        "progress will be saved. Please wait."
