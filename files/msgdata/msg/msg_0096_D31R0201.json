      "garbage": 36
    },
    {
      "id": "msg_0096_D31R0201_00008",
      "en_US": [
        "Please select the Pokémon you wish\n",
        "to enter.\r"
      ]
    },
    {
      "id": "msg_0096_D31R0201_00009",
      "en_US": "Your Pokémon must all be different.\r"
    },
    {
      "id": "msg_0096_D31R0201_00010",
      "en_US": "Held items must all be different.\r"
    },
    {
      "id": "msg_0096_D31R0201_00011",
