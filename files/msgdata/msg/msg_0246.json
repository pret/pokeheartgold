      "id": "msg_0246_00008",
      "garbage": 5
    },
    {
      "id": "msg_0246_00009",
      "garbage": 6
    },
    {
      "id": "msg_0246_00010",
      "en_US": [
        "Uh-oh...\n",
        "You have more than one Pokémon.\r",
        "You’ll have to use {STRVAR_1 1, 0, 0}, the\n",
        "first Pokémon in your party.\r",
        "Is that OK with you? {YESNO 0}"
