    {
      "id": "msg_0451_T01R0301_00004",
      "en_US": [
        "You never cease to amaze me!\r",
        "Your having completed the National\n",
        "Pokédex far exceeded my expectations!\r",
        "Meeting you is something l will cherish\n",
        "all my life long!\r"
      ]
