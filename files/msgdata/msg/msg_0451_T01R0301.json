    {
      "id": "msg_0451_T01R0301_00019",
      "en_US": [
        "Professor Oak: You did it,\n",
        "{STRVAR_1 3, 0, 0}!\f",
        "You caught both KYOGRE and GROUDON!\f",
        "OK!\f",
        "I would like to entrust this to you!\r"
